<?xml version="1.0" encoding="UTF-8"?>
<definitions name="EstoqueService"
  targetNamespace="http://soa.poc/estoque"
  xmlns="http://schemas.xmlsoap.org/wsdl/"
  xmlns:tns="http://soa.poc/estoque"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/">

  <types>
    <xsd:schema targetNamespace="http://soa.poc/estoque" elementFormDefault="qualified">
      <xsd:element name="VerificarEstoqueRequest">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="sku" type="xsd:string"/>
          <xsd:element name="quantidade" type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="VerificarEstoqueResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="disponivel" type="xsd:boolean"/>
          <xsd:element name="saldo" type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="BaixarEstoqueRequest">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="sku" type="xsd:string"/>
          <xsd:element name="quantidade" type="xsd:int"/>
          <xsd:element name="referencia" type="xsd:string" minOccurs="0"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="BaixarEstoqueResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="sucesso" type="xsd:boolean"/>
          <xsd:element name="saldoAtual" type="xsd:int"/>
          <xsd:element name="mensagem" type="xsd:string"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="ReporEstoqueRequest">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="sku" type="xsd:string"/>
          <xsd:element name="quantidade" type="xsd:int"/>
          <xsd:element name="referencia" type="xsd:string" minOccurs="0"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="ReporEstoqueResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="sucesso" type="xsd:boolean"/>
          <xsd:element name="saldoAtual" type="xsd:int"/>
          <xsd:element name="mensagem" type="xsd:string"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </types>

  <message name="VerificarEstoqueIn"><part name="parameters" element="tns:VerificarEstoqueRequest"/></message>
  <message name="VerificarEstoqueOut"><part name="parameters" element="tns:VerificarEstoqueResponse"/></message>
  <message name="BaixarEstoqueIn"><part name="parameters" element="tns:BaixarEstoqueRequest"/></message>
  <message name="BaixarEstoqueOut"><part name="parameters" element="tns:BaixarEstoqueResponse"/></message>
  <message name="ReporEstoqueIn"><part name="parameters" element="tns:ReporEstoqueRequest"/></message>
  <message name="ReporEstoqueOut"><part name="parameters" element="tns:ReporEstoqueResponse"/></message>

  <portType name="EstoquePortType">
    <operation name="verificarEstoque"><input message="tns:VerificarEstoqueIn"/><output message="tns:VerificarEstoqueOut"/></operation>
    <operation name="baixarEstoque"><input message="tns:BaixarEstoqueIn"/><output message="tns:BaixarEstoqueOut"/></operation>
    <operation name="reporEstoque"><input message="tns:ReporEstoqueIn"/><output message="tns:ReporEstoqueOut"/></operation>
  </portType>

  <binding name="EstoqueBinding" type="tns:EstoquePortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="verificarEstoque">
      <soap:operation soapAction="http://soa.poc/estoque/verificarEstoque"/>
      <input><soap:body use="literal"/></input><output><soap:body use="literal"/></output>
    </operation>
    <operation name="baixarEstoque">
      <soap:operation soapAction="http://soa.poc/estoque/baixarEstoque"/>
      <input><soap:body use="literal"/></input><output><soap:body use="literal"/></output>
    </operation>
    <operation name="reporEstoque">
      <soap:operation soapAction="http://soa.poc/estoque/reporEstoque"/>
      <input><soap:body use="literal"/></input><output><soap:body use="literal"/></output>
    </operation>
  </binding>

  <service name="EstoqueService">
    <port name="EstoquePort" binding="tns:EstoqueBinding">
      <soap:address location="http://localhost:4002/estoque"/>
    </port>
  </service>
</definitions>
